# Foxit PDF API Configuration, get your credentials from https://https://developer-api.foxit.com
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_CLOUD_API_CLIENT_ID=<YOUR_CLIENT_ID>
FOXIT_CLOUD_API_CLIENT_SECRET=<>YOUR_CLIENT_SECRET>

# --- Security (HTTP transport) ---
# Bearer token required for HTTP transport. REQUIRED when binding to a
# non-loopback host (e.g. 0.0.0.0). Clients send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
# Colon-separated directories that upload_document / download_document may
# read from / write to. Defaults to ~/Downloads:~/Desktop:~/Documents:<tmp>.
MCP_FS_ALLOWED_DIRS=
