{
  "name": "@foxitsoftware/foxit-pdf-api-mcp-server",
  "version": "1.1.2",
  "mcpName": "io.github.foxitsoftware/foxit-pdf-api-mcp-server",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "foxit-pdf-api-mcp-server": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "start:stdio": "node dist/main.js --transport stdio",
    "start:http": "node dist/main.js --transport httpStream",
    "dev": "tsx src/main.ts",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "keywords": [
    "fastmcp",
    "mcp",
    "Foxit PDF API"
  ],
  "author": "Foxit Software Inc. <support@foxitsoftware.com>",
  "homepage": "https://developer-api.foxit.com",
  "type": "module",
  "license": "MIT",
  "description": "MCP server for Foxit PDF API",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^3.20.0",
    "zod": "^3.24.4"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.9",
    "tsup": "^9",
    "tsx": "^4.23.0",
    "typescript": "^6",
    "vitest": "^4.1.0"
  }
}
